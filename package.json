{
  "name": "zone-new-checker",
  "version": "3.1.2",
  "description": "Professional IPTV credential validator with smart Base64 decoding",
  "private": true,
  "author": "kidpoleon <kidpoleon@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kidpoleon/zone-new-checker.git"
  },
  "bugs": {
    "url": "https://github.com/kidpoleon/zone-new-checker/issues"
  },
  "homepage": "https://github.com/kidpoleon/zone-new-checker#readme",
  "keywords": [
    "iptv",
    "xtream-codes",
    "stalker",
    "mag",
    "credential-validator",
    "base64-decoder",
    "nextjs",
    "react"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rm -rf .next out node_modules",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "next": "^15.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "^15.5.25",
    "tsx": "^4.23.13",
    "typescript": "5.5.4",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "glob": "10.5.0"
  }
}